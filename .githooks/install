#!/bin/sh
# 装钩子：git config core.hooksPath .githooks
# 钩子随仓库走，但 core.hooksPath 是本地配置 —— 每次新 clone 都要跑一次这个脚本。
set -eu
cd "$(git rev-parse --show-toplevel)"
chmod +x .githooks/pre-commit .githooks/pre-push .githooks/install .githooks/checks/*.py
git config core.hooksPath .githooks
printf "已启用 .githooks（pre-commit / pre-push）\n"
printf "  停用：git config --unset core.hooksPath\n"
printf "  单次跳过：git commit --no-verify / git push --no-verify\n"
command -v python3 >/dev/null 2>&1 || printf "\n⚠️  没有 python3，检查脚本跑不起来\n"
