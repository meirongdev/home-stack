#!/bin/sh
# 推送前的完整门禁 —— 这里跑的正是 docs/decisions/dual-target-axum.md 承诺外包给 CI 的两条红线，
# 本地先跑一遍，别等 CI 才红。见 docs/ROADMAP.md 段 2。
# 绕过：git push --no-verify
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
H=".githooks"

if [ -t 1 ]; then BOLD=$(printf '\033[1m'); RED=$(printf '\033[31m'); GRN=$(printf '\033[32m'); YLW=$(printf '\033[33m'); OFF=$(printf '\033[0m')
else BOLD=; RED=; GRN=; YLW=; OFF=; fi

# 只删分支的推送不必检查
deleting_only=1
while read -r _local_ref local_oid _remote_ref _remote_oid; do
  [ -z "${local_oid:-}" ] && continue
  case "$local_oid" in 0000000000000000000000000000000000000000) ;; *) deleting_only=0 ;; esac
done
[ "$deleting_only" -eq 1 ] && exit 0

command -v python3 >/dev/null 2>&1 || {
  printf "%spre-push: 找不到 python3%s\n" "$RED" "$OFF"; exit 1; }

printf "%spre-push%s\n" "$BOLD" "$OFF"
fail=0
python3 "$H/checks/hygiene.py" --all || fail=1
python3 "$H/checks/docs.py"          || fail=1

gate() {   # gate <名字> <命令...>
  name=$1; shift
  if out=$("$@" 2>&1); then
    printf "  %s ✓\n" "$name"
  else
    printf "  %s%s ✗%s  %s\n" "$RED" "$name" "$OFF" "$*"
    printf '%s\n' "$out" | tail -n 25 | sed 's/^/      /'
    fail=1
  fi
}

if [ -f Cargo.toml ]; then
  gate "格式    cargo fmt"   cargo fmt --all --check
  gate "lint    clippy"      cargo clippy --all-targets --all-features -- -D warnings
  gate "测试    cargo test"  cargo test --all

  # ── ADR 承诺的红线 1：crates/site 每一行都必须编得到 wasm32 ──
  if rustup target list --installed 2>/dev/null | grep -q '^wasm32-unknown-unknown$'; then
    # wasm32 std 由 rustup 管理。工具链统一后（2026-08-21 卸载了 Homebrew rust），
    # 默认 cargo 就是 rustup 的，wasm32 直接编得过；只判「target 是否已装」即可。
    gate "wasm32  编译约束" cargo check -p site --target wasm32-unknown-unknown
  else
    printf "  %swasm32  跳过%s —— 没装 target。装：rustup target add wasm32-unknown-unknown\n" "$YLW" "$OFF"
  fi

  if [ -d crates/xtask ]; then
    # 子命令是逐段补齐的（validate 段 1、render-diff 段 2），脚手架阶段不该一直红。
    # 但探测必须**fail-closed**：只有子命令确实不在 --help 列表里才跳过；
    # xtask 本身跑不起来要硬失败，不能因为探测失败就把门禁静默让过去
    # —— 那正是本仓库反复警告的那种「绿着的瞎子」。
    if xtask_help=$(cargo run -q -p xtask -- --help 2>&1); then
      xtask_gate() {  # xtask_gate <标签> <子命令> <还没有时的提示>
        if printf '%s\n' "$xtask_help" | grep -q -- "$2"; then
          gate "$1" cargo run -q -p xtask -- "$2"
        else
          printf "  %s%s 跳过%s —— xtask 还没有 %s 子命令（%s）\n" "$YLW" "$1" "$OFF" "$2" "$3"
        fi
      }
      # ── 内容引用完整性：硬失败（对照 fetch 的 fail-soft，见 data-pipeline 规格）──
      xtask_gate "内容    xtask validate"    validate    "段 1 要补，见 ROADMAP"
      # ── ADR 承诺的红线 2：两个编译目标必须渲染出同一份 HTML ──
      xtask_gate "漂移    xtask render-diff" render-diff "段 2 要补，见 ROADMAP"
    else
      printf "  %sxtask ✗%s  cargo run -p xtask -- --help 都跑不起来\n" "$RED" "$OFF"
      printf '%s\n' "$xtask_help" | tail -n 15 | sed 's/^/      /'
      fail=1
    fi
  fi
else
  printf "  %sRust 门禁跳过%s —— 还没有 Cargo.toml（段 1 之前，仓库只有文档）\n" "$YLW" "$OFF"
fi

if [ "$fail" -ne 0 ]; then
  printf "\n%s推送已拦下。%s 确需跳过用 git push --no-verify。\n" "$RED" "$OFF"
  exit 1
fi
printf "%s  全部通过%s\n" "$GRN" "$OFF"
